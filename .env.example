# The api this app talks to, and its version segment. Required: the app cannot start
# without them, and the build fails loudly if either is missing or malformed.
NEXT_PUBLIC_BASE_URL=http://localhost:3111/api
NEXT_PUBLIC_API_VERSION=v1

# Optional. Each one only disables the feature that needs it, and a warning is printed
# in development listing whatever is missing.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_APPLE_WEB_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
